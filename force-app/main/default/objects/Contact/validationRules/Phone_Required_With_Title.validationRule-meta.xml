<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Phone_Required_With_Title</fullName>
    <active>true</active>
    <description>POC: test field-level errors in the React app</description>
    <errorConditionFormula>AND(NOT(ISBLANK(Title)), ISBLANK(Phone))</errorConditionFormula>
    <errorDisplayField>Phone</errorDisplayField>
    <errorMessage>Phone is required when a Title is set.</errorMessage>
</ValidationRule>
